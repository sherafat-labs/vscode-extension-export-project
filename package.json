{
  "name": "source-exporter",
  "displayName": "Source Exporter",
  "description": "Exports project source code into optimized text files for AI chatbots.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "sourceExporter.exportProject",
        "title": "Source Exporter: Export Project"
      },
      {
        "command": "sourceExporter.exportStrategy",
        "title": "Source Exporter: Export Strategy"
      },
      {
        "command": "sourceExporter.exportFromFile",
        "title": "Source Exporter: Export File and Dependencies"
      },
      {
        "command": "sourceExporter.openConfig",
        "title": "Source Exporter: Open Configuration File"
      },
      {
        "command": "sourceExporter.previewExport",
        "title": "Source Exporter: Preview Export"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "sourceExporter.exportFromFile",
          "group": "7_modification"
        }
      ],
      "editor/context": [
        {
          "command": "sourceExporter.exportFromFile",
          "group": "7_modification"
        }
      ]
    },
    "configuration": {
      "title": "Source Exporter",
      "properties": {
        "sourceExporter.output.mode": {
          "type": "string",
          "enum": ["single", "multi"],
          "default": "single",
          "description": "Export output mode: single concatenated file or multiple files."
        },
        "sourceExporter.output.directory": {
          "type": "string",
          "default": "./exports",
          "description": "Output directory relative to workspace root."
        },
        "sourceExporter.output.fileName": {
          "type": "string",
          "default": "project-{timestamp}.txt",
          "description": "Output file name format for single mode."
        },
        "sourceExporter.output.multiGroupBy": {
          "type": "string",
          "enum": ["strategy", "folder", "custom"],
          "default": "strategy",
          "description": "Grouping strategy for multi-file exports."
        },
        "sourceExporter.output.includeManifest": {
          "type": "boolean",
          "default": true,
          "description": "Include JSON manifest block at the top of exports."
        },
        "sourceExporter.output.includeTree": {
          "type": "boolean",
          "default": true,
          "description": "Include ASCII tree structure of exported files."
        },
        "sourceExporter.output.includeLineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "Prefix file lines with line numbers."
        },
        "sourceExporter.format.header": {
          "type": "string",
          "default": "// ===== FILE: {path} =====",
          "description": "File header format string."
        },
        "sourceExporter.format.footer": {
          "type": "string",
          "default": "// ===== END: {path} =====",
          "description": "File footer format string."
        },
        "sourceExporter.format.fileSeparator": {
          "type": "string",
          "default": "\n\n",
          "description": "Separator string between files."
        },
        "sourceExporter.format.collapseBlankLines": {
          "type": "boolean",
          "default": true,
          "description": "Collapse consecutive blank lines into a single blank line."
        },
        "sourceExporter.format.stripComments": {
          "type": "boolean",
          "default": false,
          "description": "Strip code comments."
        },
        "sourceExporter.format.stripImports": {
          "type": "boolean",
          "default": false,
          "description": "Strip import statements."
        },
        "sourceExporter.format.maxFileSizeKB": {
          "type": "number",
          "default": 500,
          "description": "Maximum file size in KB to process."
        },
        "sourceExporter.format.encoding": {
          "type": "string",
          "default": "utf8",
          "description": "File encoding."
        },
        "sourceExporter.filters.respectGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Respect .gitignore rules."
        },
        "sourceExporter.filters.include": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["**/*"],
          "description": "Glob patterns to include."
        },
        "sourceExporter.filters.exclude": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/*.lock",
            "**/*.png",
            "**/*.jpg",
            "**/*.svg",
            "**/*.min.*"
          ],
          "description": "Glob patterns to exclude."
        },
        "sourceExporter.filters.binaryDetection": {
          "type": "boolean",
          "default": true,
          "description": "Skip binary files automatically."
        },
        "sourceExporter.tokenBudget.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable token budget limits."
        },
        "sourceExporter.tokenBudget.maxTokens": {
          "type": "number",
          "default": 100000,
          "description": "Maximum token budget per output file."
        },
        "sourceExporter.tokenBudget.splitWhenExceeded": {
          "type": "boolean",
          "default": true,
          "description": "Split export into numbered files when token budget is exceeded."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "node esbuild.js --production",
    "test": "mocha -r ts-node/register 'tests/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "mocha": "^10.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "ignore": "^5.3.1",
    "minimatch": "^9.0.3",
    "p-limit": "^3.1.0",
    "ts-morph": "^21.0.1"
  }
}
